# 复制为 /opt/shareweb/.env 后修改; 文件权限设为 600 (含管理员密码)。
# 所有变量都以 SHAREWEB_ 开头, 未设置的使用 app/config.py 里的默认值。

SHAREWEB_BASE_DIR=/opt/shareweb

# 对外访问地址 (用于生成分享链接)
SHAREWEB_PUBLIC_SCHEME=https
SHAREWEB_PUBLIC_HOST=share.example.com
SHAREWEB_PUBLIC_PORT=443

# 管理后台密码 —— 必须修改
SHAREWEB_ADMIN_PASSWORD=change-me
SHAREWEB_ADMIN_SESSION_HOURS=12

# 单文件上限默认值 (MB, 0 = 不限); 管理后台「高级设置」里改过后以后台为准
SHAREWEB_MAX_UPLOAD_MB=1024
SHAREWEB_MAX_TEXT_MB=10
# 分享保留天数
SHAREWEB_RETENTION_DAYS=30

# 提取码输错: 第 N 次起冷却 X 秒, 累计 M 次拉黑
SHAREWEB_FAIL_COOLDOWN_THRESHOLD=3
SHAREWEB_FAIL_COOLDOWN_SECONDS=60
SHAREWEB_FAIL_BLACKLIST_THRESHOLD=5

# 在反向代理 (Caddy/Nginx) 后面时为 true, 从 X-Forwarded-For 取访客 IP
SHAREWEB_TRUST_PROXY_HEADERS=true
SHAREWEB_LOG_LEVEL=INFO

# 可选: 把文件镜像到 GitHub 私有仓库, 提供「通过 GitHub 下载」。留空即禁用。
# Token 需要该仓库的 Contents 与 Releases 读写权限。
SHAREWEB_GITHUB_TOKEN=
SHAREWEB_GITHUB_REPO=
SHAREWEB_GITHUB_BRANCH=main
